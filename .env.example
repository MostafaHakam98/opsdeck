# Copy to .env. Keep credentials outside source control.
OPSDECK_TOKEN = replace-with-a-random-token-at-least-32-characters
OPSDECK_BIND=127.0.0.1
OPSDECK_PORT=8080
OPSDECK_DB=./data/opsdeck.sqlite
OPSDECK_SAMPLE_SECONDS=10
OPSDECK_RETENTION_DAYS=30
OPSDECK_ACTIONS=false
# Operator capacity edits and local image load/build/tag, separately enabled.
OPSDECK_OPERATIONS=false
OPSDECK_RUNNER_CONTROL_SOCKET=
OPSDECK_IMAGE_UPLOAD_DIR=./data/image-uploads
OPSDECK_IMAGE_UPLOAD_MAX_GIB=32
OPSDECK_BUILD_CONTEXTS_FILE=
# Optional Compose overrides: compose.control.yaml and compose.builds.yaml.
# OPSDECK_CONTROL_GID: numeric host opsdeck-control group ID.
# OPSDECK_BUILD_ROOT: host directory containing approved build checkouts.
# OPSDECK_BUILD_PROFILES: private JSON file defining node build profiles.
# Only containers labeled opsdeck.managed=true can be stopped/restarted.
DOCKER_HOST=unix:///var/run/docker.sock
# Optional, read-only integrations. Never put these credentials in the browser.
GITLAB_URL=
GITLAB_TOKEN =
GITLAB_PROJECT_IDS=
OPSDECK_GITLAB_CONNECTION_FILE=./data/gitlab-connection.json
RUNNER_METRICS_URL=http://127.0.0.1:9252/metrics
# Optional administrator-generated runner facts; no runner token is read.
OPSDECK_RUNNER_FACTS=./data/runner-facts.json
OPSDECK_SERVICES=docker.service,gitlab-runner.service,tailscaled.service
OPSDECK_FINDINGS_PATH=./data/findings.json
# Compose options; the host override supplies scope/procfs settings automatically.
OPSDECK_PUBLISH_IP=127.0.0.1
# Set OPSDECK_DOCKER_GID to the Docker socket's group ID, or use make docker-up.
