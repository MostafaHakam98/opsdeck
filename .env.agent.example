# Copy to .env.agent on ONE runner host, chmod 600, and use that host's credential.
# Enroll the host in the central dashboard before starting the agent.
OPSDECK_SERVER_URL=https://opsdeck.example.com
OPSDECK_AGENT_TOKEN=replace-with-the-credential-issued-for-this-host
OPSDECK_SAMPLE_SECONDS=10
OPSDECK_AGENT_SPOOL=./data/agent.sqlite
OPSDECK_AGENT_QUEUE_SAMPLES=360
OPSDECK_AGENT_QUEUE_MIB=64
RUNNER_METRICS_URL=http://127.0.0.1:9252/metrics
OPSDECK_RUNNER_FACTS=./data/runner-facts.json
OPSDECK_SERVICES=docker.service,gitlab-runner.service
# Optional corporate CA bundle and outbound proxy, with certificate verification enabled:
# SSL_CERT_FILE=/etc/ssl/certs/company-ca-bundle.pem
# HTTPS_PROXY=http://proxy.example.com:3128

# Optional full workspace through the existing host API (no inbound agent port).
# OPSDECK_WORKSPACE_URL must be an HTTP origin on 127.0.0.1 or [::1].
# Set OPSDECK_WORKSPACE_TOKEN to that host workspace's access token in this private file.
# Example workspace URL: http://127.0.0.1:8080
